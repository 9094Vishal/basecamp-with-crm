# Basecamp OAuth app credentials (from https://launchpad.37signals.com/integrations)
BASECAMP_CLIENT_ID=your_client_id_here
BASECAMP_CLIENT_SECRET=your_client_secret_here
BASECAMP_REDIRECT_URI=http://localhost:4000/auth/basecamp/callback

# Public URL for webhook delivery – must be the current ngrok HTTPS URL.
# IMPORTANT: This URL changes on every free-tier ngrok restart. Update it and
# re-push any Basecamp projects (which re-registers the webhook) whenever ngrok restarts.
PUBLIC_BASE_URL=https://<your-ngrok-subdomain>.ngrok-free.app

# Shared secret used to verify inbound webhook signatures (any random string)
WEBHOOK_SECRET=replace_with_a_long_random_string

# Backend port
PORT=4000

# Frontend origin (for CORS) – must match the Vite dev server
CLIENT_URL=http://localhost:5173

# Embedded in the User-Agent header sent to Basecamp API
USER_AGENT_EMAIL=you@example.com
